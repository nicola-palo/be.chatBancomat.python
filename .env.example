# Environment: true = production, false = development
PRODUCTION=false

# Google AI API Key (ottieni da https://makersuite.google.com/app/apikey)
GOOGLE_API_KEY=your-api-key-here

# Server config
PORT=8081
HOST=0.0.0.0

# Debug mode (disable in production)
DEBUG=true

# Backend Java connection
BE_URL=http://localhost:8080
BE_API_KEY=atm-internal-secret-key-change-in-prod

# CORS allowed origins (comma-separated)
# Dev: localhost only
# Prod: add your GitHub Pages URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
